{
  "name": "assignly",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start:test": "turbo run start:test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,scss,html}\"",
    "check-types": "turbo run check-types",
    "validate": "turbo run lint check-types build --filter='!@repo/redux-toolkit'",
    "prepare": "husky",
    "watch": "turbo run watch"
  },
  "dependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "next": "16.0.10"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "next-auth@<4.24.12": ">=4.24.12",
      "hono@<4.9.7": ">=4.9.7",
      "hono@>=1.1.0 <4.10.2": ">=4.10.2",
      "hono@<4.10.3": ">=4.10.3",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "body-parser@>=2.2.0 <2.2.1": ">=2.2.1",
      "valibot@>=0.31.0 <1.2.0": ">=1.2.0",
      "next@>=15.5.0-canary.0 <15.5.7": ">=15.5.7",
      "next@>=16.0.0-beta.0 <16.0.10": ">=16.0.10",
      "next@16.0.7": "16.0.10"
    }
  }
}
