{
  "name": "@repo/express",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm dlx tsc-alias -p tsconfig.build.json",
    "dev": "pnpm run build && cross-env NODE_ENV=development nodemon ./JS/server/server.js",
    "start:prod": "pnpm run build && cross-env NODE_ENV=production node ./JS/clusterManager/clusterManager.js",
    "start:test": "pnpm run build && cross-env NODE_ENV=testing node ./JS/server/server.js",
    "worker": "cross-env NODE_ENV=development node ./JS/redis/Workers/writeWorkers.js",
    "lint": "eslint .",
    "watch": "tsc --watch",
    "check-types": "tsc --noEmit",
    "seed-prisma": "npx tsx data/seeder.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "exports": {},
  "dependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prisma": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0",
    "nodemailer": "^9.0.1",
    "nodemailer-express-handlebars": "^7.0.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0",
    "zodex-axon": "^1.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-handlebars": "^6.0.2",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  }
