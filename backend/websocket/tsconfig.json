{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./JS",
    "rootDir": ".",
    "target": "es2022",
    "paths": {
      "@src/*": ["./src/*"],
      "@config/*": ["./config/*"],
      "@constants/*": ["./constants/*"],
      "@types/*": ["./types/*"],
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "JS"]
}
