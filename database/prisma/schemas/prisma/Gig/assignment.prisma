model Assignment {
    id String @id @default(uuid())

    title          String
    description    String
    category       skills  @default(CODING)
    descriptionPDF String?
    referencePDF   String?
    instructions   String?

    subject  String[] @default([])
    amount   Int
    postedBy String
    user     User     @relation(fields: [postedBy], references: [id], onDelete: Cascade)

    deliveryDate      DateTime
    deliveryAddress   String
    deliveryLatitude  Decimal
    deliveryLongitude Decimal

    additionalStationaryAmount Int?
    additionalStationary       String[] @default([])

    status AssignmentStatus @default(OPEN)

    application Application[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([postedBy])
    @@map("assignments")
}

enum AssignmentStatus {
    OPEN
    ASSIGNED
    SUBMITTED
    CANCELLED
}

enum skills {
    DSA
    WEB_DEV
    CODING
    DATABASE
    DESIGN
    WRITING
    OTHERS
}
