model Application {
    id              String            @id @default(uuid())
    gigId           String
    applicantId     String
    negotiatedPrice Decimal
    status          ApplicationStatus @default(PENDING)
    createdAt       DateTime          @default(now())
    updatedAt       DateTime          @updatedAt

    assignment Assignment @relation(fields: [gigId], references: [id], onDelete: Cascade)
    user       User       @relation(fields: [applicantId], references: [id], onDelete: Cascade)

    @@unique([gigId, applicantId])
    @@index([gigId])
}

enum ApplicationStatus {
    PENDING
    ACCEPTED
    REJECTED
}
